	)
	(text "100 MHz: S1=0, S0=1\nNo spread: SS1/SS0 NC (internal pull-ups). Tied to GND = +/-0.25% centre spread, out of PCIe spec (Rev B fault, item 8)\nAlways enabled: OE=1"
		(exclude_from_sim no)
		(at 20.32 60.96 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "2a5f74ff-994e-485b-a1cf-5e7c8d925c13")
	)
	(text "Y1: X322525MRB4SI / C70593\nCL=18pF; 20pF starting load capacitors\nKeep crystal loop short; ground pads 2/4."
		(exclude_from_sim no)
		(at 20.32 154.94 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "42ec70bf-82d6-4898-9793-497c685e3e09")
	)
	(text "CLK0 -> FPGA: AC-coupled; internal 100-ohm receiver\nCLK1 -> M.2: DC-coupled HCSL; dedicated output pair"
		(exclude_from_sim no)
		(at 127 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aaf91b56-0223-4cfb-949b-61ef4c8a16a6")
	)
	(text "Layout: series/shunt resistors close to U44; shunts BEFORE FPGA AC capacitors.\nRoute independent 100-ohm differential pairs; no output branching.\nKeep PS_POR_B asserted until clocks are stable (U44 startup allowance: 3ms)."
		(exclude_from_sim no)
		(at 20.32 185.42 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "ebb93802-d0f5-4b80-8b8e-fed68e517007")
	)
